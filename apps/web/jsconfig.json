{
  "compilerOptions": {
    "checkJs": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.js", "**/*.jsx", "../../packages/**/*.jsx"],
  "exclude": ["node_modules", ".next"]
}
