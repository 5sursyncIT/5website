# Copier en .env pour le développement local. Ne jamais committer .env.

# ── Base de données ──────────────────────────────────────────────────────
POSTGRES_USER=5sync
POSTGRES_PASSWORD=changez-moi-en-local-et-jamais-en-production
POSTGRES_DB=5sync

# DEUX CONNEXIONS, ET CE N'EST PAS UNE COMPLICATION GRATUITE.
#
# DATABASE_URL      propriétaire des tables. Migrations et amorçage seulement.
#                   PostgreSQL le laisse contourner Row-Level Security.
# DATABASE_APP_URL  rôle app_5sync, non superutilisateur. LE SEUL que l'API
#                   utilise, et le seul à qui les politiques d'isolation
#                   s'appliquent.
#
# Les confondre ferait disparaître l'isolation entre organisations sans qu'aucune
# requête ne cesse de fonctionner : elles verraient simplement tout. L'API refuse
# de démarrer en production si les deux sont identiques.
DATABASE_URL=postgres://5sync:changez-moi-en-local-et-jamais-en-production@postgres:5432/5sync
DATABASE_APP_URL=postgres://app_5sync:changez-moi-aussi@postgres:5432/5sync
DATABASE_APP_PASSWORD=changez-moi-aussi

# ── Sessions ─────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=12
SESSION_COOKIE=5sync_session

# ── API ──────────────────────────────────────────────────────────────────
API_PORT=4000

# Stockage des documents. DOIT être hors de toute racine servie par Nginx ou
# Next : aucune URL ne mène directement à un fichier, seule une route
# authentifiée les lit.
# En local, /srv n'est généralement pas accessible en écriture : les deux tests
# de dépôt de fichier échouent alors en 500, ce qui a tout l'air d'un défaut du
# code. Posez la variable dans votre .env.test — par exemple
# DOCUMENTS_DIR=/tmp/5sync-documents-test. La CI pose la sienne.
DOCUMENTS_DIR=/srv/5sync/documents
DOCUMENTS_TAILLE_MAX=26214400

# ── Supervision ──────────────────────────────────────────────────────────
# Jeton du collecteur de métriques (/api/v1/metrics). SANS LUI, LA ROUTE
# RÉPOND 404 et ce service n'émet aucune métrique : le démarrage l'annonce
# alors bruyamment, et la règle d'alerte « MetriquesAbsentes » d'
# infra/supervision/alertes.yml fait du silence lui-même une alerte.
#
# Les métriques disent combien d'organisations sont clientes et combien de
# comptes existent. Ce sont des chiffres commerciaux : d'où un jeton, et non
# « c'est interne, personne n'ira voir ».
#
#   METRICS_TOKEN=$(openssl rand -hex 32)
METRICS_TOKEN=

# ── Sauvegardes ──────────────────────────────────────────────────────────
# Clé PUBLIQUE age. Elle suffit à chiffrer : la machine qui sauvegarde n'a
# jamais besoin du secret qui déchiffre, donc la compromettre ne donne pas
# accès aux sauvegardes passées. Générez la paire avec ./infra/age-cles.sh.
SAUVEGARDE_DESTINATAIRE=

# Chemin du fichier d'identité age. À NE RENSEIGNER QUE SUR LA MACHINE OÙ L'ON
# RESTAURE, jamais dans le .env du serveur : un serveur compromis avec son
# propre secret de déchiffrement, c'est un attaquant qui repart avec
# l'historique entier des données clients.
SAUVEGARDE_IDENTITE=

# « exigee » refuse tout chiffrement non authentifié, « toleree » l'accepte.
# Par défaut : exigé dès que NODE_ENV=production.
SAUVEGARDE_AUTHENTIFICATION=

# Répertoire des sauvegardes. Lu en écriture par les scripts, en LECTURE SEULE
# par l'API, qui en tire l'âge de la dernière sauvegarde.
SAUVEGARDE_DIR=

# Phrase secrète, employée seulement par les méthodes gpg et openssl — c'est-à-
# dire hors production. Inutile avec age.
SAUVEGARDE_CLE=

# ── Dépôt hors site ──────────────────────────────────────────────────────
# Une sauvegarde posée sur la machine qu'elle protège ne protège de rien : elle
# couvre la suppression accidentelle, et aucun des sinistres contre lesquels on
# sauvegarde. En production, ./infra/hors-site.sh refuse de tourner sans ces
# deux valeurs.
#
#   HORS_SITE_TRANSPORT=rsync   HORS_SITE_CIBLE=sauvegardes@nas.local:/vol/5sync
#   HORS_SITE_TRANSPORT=rclone  HORS_SITE_CIBLE=ovh:5sync-sauvegardes/base
HORS_SITE_TRANSPORT=
HORS_SITE_CIBLE=
# Plus longue que la rotation locale de sept jours : le local couvre l'incident
# courant, le hors site couvre celui qu'on découvre tard.
HORS_SITE_RETENTION_JOURS=30

# ── Courrier ─────────────────────────────────────────────────────────────
# Sans SMTP_HOST, les notifications ne partent pas et sont journalisées — le
# service refuse néanmoins de démarrer ainsi en production, sauf
# MAIL_DESACTIVE=1 posé explicitement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=5/Sync IT <contact@5sursync.com>
MAIL_DESACTIVE=0

# ── Web ──────────────────────────────────────────────────────────────────
# URL interne de l'API, vue depuis le conteneur web (réseau Docker).
API_INTERNAL_URL=http://api:4000

# Publie l'atelier de composants sur un build de production.
# À poser sur la recette, JAMAIS en production. Évalué AU BUILD, pas au
# démarrage : la page est pré-générée, changer la variable après coup n'a
# aucun effet — il faut reconstruire.
ENABLE_DESIGN_WORKSHOP=0
